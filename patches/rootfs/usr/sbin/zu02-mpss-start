#!/bin/sh
set -eu

firmware_dir=/firmware/image
firmware_files='mba.mbn modem.mdt modem.b00 modem.b01 modem.b02 modem.b03 modem.b05 modem.b06 modem.b07 modem.b08 modem.b09 modem.b10 modem.b11 modem.b12 modem.b13 modem.b14 modem.b15 modem.b16 modem.b19 modem.b20 modem.b21 modem.b22 modem.b23 modem.b24'

if ! mountpoint -q /firmware; then
    mount /firmware
fi

mount_options="$(findmnt -nro OPTIONS /firmware)"
case ",$mount_options," in
    *,ro,*) ;;
    *)
        echo 'zu02-mpss-start: modem firmware partition is not read-only' >&2
        exit 1
        ;;
esac

for firmware_name in $firmware_files; do
    firmware_path="$firmware_dir/$firmware_name"
    firmware_link="/usr/lib/firmware/$firmware_name"
    [ -s "$firmware_path" ] || {
        echo "zu02-mpss-start: missing $firmware_path" >&2
        exit 1
    }
    [ -L "$firmware_link" ] || {
        echo "zu02-mpss-start: $firmware_link is not a symbolic link" >&2
        exit 1
    }
    [ "$(readlink "$firmware_link")" = "$firmware_path" ] || {
        echo "zu02-mpss-start: unexpected target for $firmware_link" >&2
        exit 1
    }
done

modprobe qcom_bam_dmux
modprobe rpmsg_wwan_ctrl
modprobe qcom_q6v5_mss

attempt=0
while [ "$attempt" -lt 60 ]; do
    attempt=$((attempt + 1))
    for remoteproc in /sys/class/remoteproc/remoteproc*; do
        [ -r "$remoteproc/name" ] || continue
        name="$(cat "$remoteproc/name")"
        firmware="$(cat "$remoteproc/firmware" 2>/dev/null || true)"
        case "$name:$firmware" in
            *4080000*|*modem*|*mpss*|*MSS*) ;;
            *) continue ;;
        esac

        state="$(cat "$remoteproc/state")"
        if [ "$state" = running ]; then
            echo "zu02-mpss-start: $name is running"
            exit 0
        fi
        if [ "$state" = offline ]; then
            echo start > "$remoteproc/state"
        fi
    done
    sleep 1
done

echo 'zu02-mpss-start: MPSS remote processor did not reach running state' >&2
exit 1
