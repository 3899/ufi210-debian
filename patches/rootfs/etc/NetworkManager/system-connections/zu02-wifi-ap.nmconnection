[connection]
id=ZU02 Wi-Fi AP
uuid=89090000-0000-4000-8000-000000000069
type=wifi
interface-name=wlan0
autoconnect=false

[wifi]
band=bg
channel=6
cloned-mac-address=stable
mode=ap
powersave=2
ssid=ZU02-Debian

[wifi-security]
key-mgmt=wpa-psk
psk=simadmin
proto=rsn;
pairwise=ccmp;
group=ccmp;

[ipv4]
address1=192.168.69.1/24
method=shared
never-default=true

[ipv6]
method=disabled
